{
  "expo": {
    "name": "Bloome",
    "slug": "bloome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lailatussiyamu.bloome",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17382B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lailatussiyamu.bloome",
      "allowBackup": false,
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthUpdateUsageDescription": "Bloome tidak menulis data kesehatan.",
          "background": false,
          "NSHealthShareUsageDescription": "Bloome membaca langkah hari ini jika kamu mengizinkan, untuk ditampilkan hanya di perangkat."
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Bloome memakai lokasi sekali saat kamu menekan cek lokasi. Koordinat tidak disimpan."
        }
      ]
    ],
    "scheme": "bloome",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
